{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/navrh/",
      "destination": "/navrh",
      "permanent": true
    },
    {
      "source": "/navrh",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/navrh/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/puvodni/",
      "destination": "/puvodni",
      "permanent": true
    },
    {
      "source": "/inner",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/inner/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/inner.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/img/:path*",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/gallery/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/puvodni/assets/gallery/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/puvodni/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
